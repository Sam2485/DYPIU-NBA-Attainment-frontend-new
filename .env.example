# ==============================================================================
# DYPIU NBA Attainment Frontend - Environment Configuration Example
# ==============================================================================

# Option 1: Linux VM Production Deployment (Frontend and Backend on separate ports)
# Replace <VM-IP> with your Linux VM public IP, private IP, or domain name:
VITE_API_BASE_URL=http://<VM-IP>:8010/api/v1

# Option 2: Local Development (routed through Vite dev proxy on port 5173 -> 8010)
# VITE_API_BASE_URL=/api/v1
